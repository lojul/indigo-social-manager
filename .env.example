# ── Social Media Manager – Environment Variables ─────────────────────────────
# For local dev:  copy to .env.local and fill in your keys
# For Vercel:     add each variable in Project → Settings → Environment Variables

# Tavily (trend search)  →  https://tavily.com
TAVILY_API_KEY=your_tavily_api_key

# imgbb (image hosting for Buffer posts)  →  https://api.imgbb.com
IMGBB_API_KEY=your_imgbb_api_key

# Buffer (social scheduling)  →  https://publish.buffer.com/settings/api
BUFFER_API_TOKEN=your_buffer_api_token

# OpenRouter (AI post generation)  →  https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
